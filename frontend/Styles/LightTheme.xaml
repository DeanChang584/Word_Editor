<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Light Theme — Office/WPS professional style
         Accent: #005FBA  |  Background: #FFFFFF
         Text: #201F1E / #323130 / #605E5C
         Border: #D1D1D1  |  Divider: #EDEBE9
         ============================================================ -->

    <!-- ── Surfaces (参考 v2.0.1: 纯白窗口背景 vs 纯白卡片, 靠边框分层) ── -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F9F9F9" />

    <!-- ── 输入框边框 (v2.0.1 #D5D5D5 之上加深, 保证框体明显可辨) ── -->
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#666666" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#005FBA" />
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#C8C8C8" />

    <!-- ── Navigation Bar (v2.0.1: #FAFAFA 浅灰导航, 选中 #E8F0FE) ── -->
    <SolidColorBrush x:Key="NavBarBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="NavItemSelectedBackground" Color="#E8F0FE" />
    <SolidColorBrush x:Key="NavItemSelectedForeground" Color="#005FBA" />
    <SolidColorBrush x:Key="NavItemHoverBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NavItemDefaultIcon" Color="#605E5C" />
    <SolidColorBrush x:Key="NavItemDefaultText" Color="#201F1E" />

    <!-- ── File List Drop Area (v2.0.1: #D1D1D1) ─────────────── -->
    <SolidColorBrush x:Key="FileListBorderBrush" Color="#D1D1D1" />

    <!-- ── Accent Button (App.xaml AccentButtonStyle) ───────── -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#005FBA" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />

    <!-- ── Accent Button states (used by App.xaml AccentButtonStyle) ── -->
    <SolidColorBrush x:Key="AccentButtonPointerOverBackground" Color="#146CBF" />
    <SolidColorBrush x:Key="AccentButtonPressedBackground" Color="#004A91" />
    <SolidColorBrush x:Key="AccentButtonDisabledBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AccentButtonDisabledForeground" Color="#A19F9D" />

    <!-- ── CheckBox checked states (accent blue family) ───────────── -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#005FBA" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#146CBF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#004A91" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#005FBA" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#146CBF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#004A91" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />

</ResourceDictionary>
